#!/usr/bin/env node
import spawn from "cross-spawn";
import { getBinaryPath } from "../utils.js";

// argv is always [node, script, ...args], however the script was invoked
const child = spawn(getBinaryPath(), process.argv.slice(2), {
  stdio: "inherit",
});

child.on("error", (err) => {
  console.error(`Failed to start pocketbase: ${err.message}`);
  process.exit(1);
});

// Exit the same way pocketbase did
child.on("exit", (code, signal) => {
  if (signal) {
    process.kill(process.pid, signal);
  } else {
    process.exit(code ?? 1);
  }
});
